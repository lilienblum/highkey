{
  "$defs": {
    "Better": {
      "enum": ["up", "down"],
      "type": "string"
    },
    "Color": {
      "enum": ["yellow", "violet", "aqua", "green", "red", "neutral"],
      "type": "string"
    },
    "Compare": {
      "oneOf": [
        {
          "enum": ["previous_period"],
          "type": "string"
        },
        {
          "const": "none",
          "description": "Opts out of the previous-period default.",
          "type": "string"
        }
      ]
    },
    "EventMeasure": {
      "enum": [
        "count",
        "actors",
        "sessions",
        "new_actors",
        "unique_groups",
        "first_time",
        "once_per_user",
        "returning_actors",
        "unique",
        "sum",
        "avg",
        "p50",
        "p90",
        "p95",
        "p99",
        "min",
        "max"
      ],
      "type": "string"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "property": {
          "type": "string"
        },
        "value": {
          "description": "A string, number or boolean; a list of 1-50 of them for in and not_in; a string for contains and not_contains; absent for exists and not_exists."
        }
      },
      "required": ["property", "op"],
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "in",
        "not_in",
        "contains",
        "not_contains",
        "starts_with",
        "ends_with",
        "regex",
        "empty",
        "not_empty",
        "exists",
        "not_exists"
      ],
      "type": "string"
    },
    "FunnelBy": {
      "enum": ["actor", "session", "group"],
      "type": "string"
    },
    "LogFilter": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string"
        },
        "value": {
          "description": "As for an event filter."
        },
        "op": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterOp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent means eq."
        }
      },
      "required": ["attribute"],
      "type": "object"
    },
    "LogMeasure": {
      "enum": ["count", "unique", "sum", "avg", "p50", "p90", "p95", "p99", "min", "max"],
      "type": "string"
    },
    "Period": {
      "enum": ["day", "week", "month"],
      "type": "string"
    },
    "QuerySpec": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": ["string", "null"]
            },
            "filters": {
              "items": {
                "$ref": "#/$defs/Filter"
              },
              "type": "array"
            },
            "group_by": {
              "type": ["string", "null"]
            },
            "identity_kind": {
              "type": ["string", "null"]
            },
            "measure": {
              "$ref": "#/$defs/EventMeasure",
              "default": "count"
            },
            "property": {
              "type": ["string", "null"]
            },
            "signal": {
              "const": "events",
              "type": "string"
            },
            "source_id": {
              "type": ["string", "null"]
            }
          },
          "required": ["signal"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attribute": {
              "type": ["string", "null"]
            },
            "environment": {
              "type": ["string", "null"]
            },
            "filters": {
              "items": {
                "$ref": "#/$defs/LogFilter"
              },
              "type": "array"
            },
            "group_by": {
              "type": ["string", "null"]
            },
            "level": {
              "type": ["string", "null"]
            },
            "measure": {
              "$ref": "#/$defs/LogMeasure",
              "default": "count"
            },
            "min_level": {
              "type": ["string", "null"]
            },
            "search": {
              "type": ["string", "null"]
            },
            "service": {
              "type": ["string", "null"]
            },
            "signal": {
              "const": "logs",
              "type": "string"
            },
            "source_id": {
              "type": ["string", "null"]
            }
          },
          "required": ["signal"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered steps, each an event with optional filters. Counts how many actors (or sessions) reach each step, in order, within `window` of their first step. Its result is one group per step; its total is the last step.",
          "properties": {
            "by": {
              "$ref": "#/$defs/FunnelBy",
              "default": "actor"
            },
            "group_type": { "type": ["string", "null"] },
            "signal": {
              "const": "funnel",
              "type": "string"
            },
            "source_id": {
              "type": ["string", "null"]
            },
            "steps": {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "type": "array"
            },
            "window": {
              "default": "7d",
              "description": "How long after the first step the last may happen: 1\u20133 digits and h or d.",
              "type": "string"
            }
          },
          "required": ["signal", "steps"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cohorts of actors by the period of their first `start` event in the range, and the share of each cohort that sent a `return` event in each following period. Its result is a table: cohort, size and p0 (the cohort's own period, always 1) to p<periods>.",
          "properties": {
            "period": {
              "$ref": "#/$defs/Period",
              "default": "week"
            },
            "periods": {
              "default": 8,
              "description": "How many periods after the cohort's own: 1\u201312.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "return": {
              "$ref": "#/$defs/Step"
            },
            "signal": {
              "const": "retention",
              "type": "string"
            },
            "source_id": {
              "type": ["string", "null"]
            },
            "start": {
              "$ref": "#/$defs/Step"
            }
          },
          "required": ["signal", "start", "return"],
          "type": "object"
        }
      ]
    },
    "Series": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "expr": {
          "type": "string"
        },
        "label": {
          "type": ["string", "null"]
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/Threshold"
          },
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["expr"],
      "type": "object"
    },
    "Size": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "w": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["w", "h"],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "type": "array"
        }
      },
      "required": ["event"],
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "double",
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/Color"
        }
      },
      "required": ["at", "color"],
      "type": "object"
    },
    "Unit": {
      "enum": ["number", "percent", "ratio", "ms", "seconds", "bytes"],
      "type": "string"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "better": {
          "anyOf": [
            {
              "$ref": "#/$defs/Better"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which direction of change is good, so growth is coloured as an outcome. Absent means\n`down` for `ms` and `seconds` values and `up` otherwise."
        },
        "bucket": {
          "type": ["string", "null"]
        },
        "compare": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "limit": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "markdown": {
          "type": ["string", "null"]
        },
        "prefix": {
          "type": ["string", "null"]
        },
        "sparkline": {
          "type": ["boolean", "null"]
        },
        "stacked": {
          "type": ["boolean", "null"]
        },
        "suffix": {
          "type": ["string", "null"]
        },
        "type": {
          "$ref": "#/$defs/ViewKind"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "ViewKind": {
      "oneOf": [
        {
          "enum": ["stat", "line", "area", "bar", "ranking", "map", "events", "logs", "text"],
          "type": "string"
        },
        {
          "const": "table",
          "description": "One retention query or funnel, or typed queries sharing a group_by: one row per group and one column per query.",
          "type": "string"
        }
      ]
    },
    "Widget": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": ["string", "null"]
        },
        "id": {
          "type": "string"
        },
        "queries": {
          "additionalProperties": {
            "$ref": "#/$defs/QuerySpec"
          },
          "default": {},
          "type": "object"
        },
        "range": {
          "type": ["string", "null"]
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "type": ["array", "null"]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Size"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "title": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/View"
        }
      },
      "required": ["id", "title", "view"],
      "type": "object"
    }
  },
  "$id": "/api/read/schemas/dashboard.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "name": {
      "type": "string"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "type": "array"
    }
  },
  "required": ["version", "name", "widgets"],
  "title": "Document",
  "type": "object"
}
