{
  "name": "highkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "errors:generate": "bun --bun errkit generate",
    "dev": "bun scripts/dev.ts",
    "build": "bun run build:sdk && bun run --cwd apps/app build && bun typecheck",
    "build:sdk": "bun run --cwd sdk/typescript build",
    "fmt": "bun fmt && cargo fmt --all",
    "fmt:check": "bun fmt --no-script --check && cargo fmt --all --check",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./sdk ./scripts ./apps/app/test",
    "test:e2e": "bun scripts/e2e.ts",
    "test:load": "bun scripts/load-test.ts",
    "benchmark:logs": "bun scripts/benchmark-logs.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "seed": "bun scripts/seed.ts",
    "migrate": "bun apps/app/src/server/clickhouse/migrate-cli.ts",
    "dev:app": "bun run --cwd apps/app dev",
    "dev:stop": "bun scripts/dev.ts --stop",
    "dev:standalone": "bun scripts/dev-standalone.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "errkit": "0.5.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "apps/app",
    "sdk/typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "tako.sh": "0.0.0-419336e"
  }
}
