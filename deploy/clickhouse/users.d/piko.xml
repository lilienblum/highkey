<!-- Settings every ClickHouse user starts from. Piko property and attribute keys may contain
     dots ("utm.source"); without escaping, the JSON type would store them as nested paths. -->
<clickhouse>
    <profiles>
        <default>
            <json_type_escape_dots_in_keys>1</json_type_escape_dots_in_keys>
        </default>
    </profiles>
</clickhouse>
